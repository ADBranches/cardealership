
############################################################
# PANDA MOTORS BACKEND API TESTS
# STANDARD BACKEND PORT: 5500
############################################################

@baseUrl = http://localhost:5500

# IMPORTANT:
# These tokens must come from the application's real login flow.
# Do not generate synthetic tokens or commit real tokens here.
@adminToken = replace-with-local-admin-access-token

@customerToken = replace-with-local-customer-access-token


############################################################
# TEST IDENTITIES
############################################################
#
# Authentication:
# - Admin token comes from POST /api/auth/login
# - Customer token comes from POST /api/auth/login
#
# Inventory:
# - Vehicle ID is returned by POST /api/cars
# - Do not assume a fixed vehicle ID.
#
# Chat:
# - Existing chat tests use customer ID 2 and car ID 1.
# - These IDs are retained for the existing chat verification
#   scenarios and are not used as the source of authentication.
#
############################################################


############################################################
# AUTH ROUTES
############################################################

### REGISTER ADMIN USER
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Admin User",
  "email": "admin@cars.com",
  "password": "replace-with-local-test-password",
  "role": "admin"
}


### LOGIN ADMIN USER
#
# Use the response access token as @adminToken.
#
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@cars.com",
  "password": "replace-with-local-test-password"
}


### REGISTER CUSTOMER USER
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Customer One",
  "email": "customer1@cars.com",
  "password": "replace-with-local-test-password",
  "role": "user"
}


### LOGIN CUSTOMER USER
#
# Use the response access token as @customerToken.
#
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "customer1@cars.com",
  "password": "replace-with-local-test-password"
}


############################################################
# CAR ROUTES - PUBLIC
############################################################

### GET ALL CARS
GET {{baseUrl}}/api/cars


### GET SINGLE CAR
GET {{baseUrl}}/api/cars/1


############################################################
# CURRENT FILTER / SORTING STATUS
############################################################
#
# The active cars controller currently does not implement
# server-side filtering or sorting from query parameters.
#
# These requests are retained as contract checks only.
#
############################################################

### FILTER BY MAKE
GET {{baseUrl}}/api/cars?make=Toyota


### FILTER BY MODEL
GET {{baseUrl}}/api/cars?model=Harrier


### FILTER BY YEAR
GET {{baseUrl}}/api/cars?year=2022


### FILTER BY PRICE RANGE
GET {{baseUrl}}/api/cars?minPrice=20000000&maxPrice=50000000


### PRICE - LOW TO HIGH
GET {{baseUrl}}/api/cars?sortBy=price_asc


### PRICE - HIGH TO LOW
GET {{baseUrl}}/api/cars?sortBy=price_desc


### NEWEST VEHICLES BY YEAR
GET {{baseUrl}}/api/cars?sortBy=newest


### FILTER + SORT TOGETHER
GET {{baseUrl}}/api/cars?make=Toyota&minPrice=100000000&maxPrice=400000000&sortBy=price_asc


############################################################
# ISSUE #46 - INVENTORY MANAGEMENT
############################################################
#
# COMPLETE VEHICLE CONTRACT
#
# Identity:
#   make  = manufacturer
#   model = vehicle model/family
#   name  = complete human-readable listing name
#
# Inventory:
#   type
#   category
#   year
#   price
#   mileage
#   color
#   condition
#   status
#   vin
#   description
#
# Specifications:
#   power
#   engine
#   drive
#
# Images are uploaded separately after the vehicle has been
# created because the image endpoint requires a car ID.
#
############################################################


### ISSUE #46 - CREATE COMPLETE VEHICLE
POST {{baseUrl}}/api/cars
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "vin": "JT1234567890ABC12",
  "make": "Toyota",
  "model": "Land Cruiser 300",
  "name": "Toyota Land Cruiser 300 GR Sport",
  "type": "SUV",
  "category": "luxury",
  "year": 2025,
  "price": 250000000,
  "mileage": 12000,
  "color": "White",
  "condition": "Used",
  "status": "Available",
  "description": "Issue #46 inventory test vehicle.",
  "power": "409 HP",
  "engine": "3.5L V6",
  "drive": "4WD"
}


############################################################
# ISSUE #46 - VEHICLE READ-BACK
############################################################
#
# After CREATE CAR:
#
# Replace <CREATED_CAR_ID> with the ID returned by the
# previous request.
#
# The response should contain the complete persisted vehicle
# contract and its images array.
#
############################################################

### ISSUE #46 - GET CREATED VEHICLE
GET {{baseUrl}}/api/cars/<CREATED_CAR_ID>


############################################################
# ISSUE #46 - INVENTORY LIST VERIFICATION
############################################################
#
# Confirms the created vehicle is visible through the
# public inventory endpoint.
#
############################################################

### ISSUE #46 - GET INVENTORY
GET {{baseUrl}}/api/cars


############################################################
# IMAGE UPLOAD / OPTIMIZATION
############################################################


### TEST IMAGE UPLOAD
#
# Development/testing endpoint only.
#
POST {{baseUrl}}/api/cars/test-upload
Content-Type: multipart/form-data

image: @C:/Users/admin/Downloads/toyota-vehicle.jpg


### ISSUE #46 - UPLOAD PRIMARY VEHICLE IMAGE
#
# Replace <CREATED_CAR_ID> with the vehicle ID returned by
# POST /api/cars.
#
POST {{baseUrl}}/api/cars/upload
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=CarImageBoundary

--CarImageBoundary
Content-Disposition: form-data; name="carId"

<CREATED_CAR_ID>
--CarImageBoundary
Content-Disposition: form-data; name="imageType"

primary
--CarImageBoundary
Content-Disposition: form-data; name="image"; filename="toyota-car.jpg"
Content-Type: image/jpeg

< C:/Users/admin/Downloads/toyota-vehicle.jpg
--CarImageBoundary--


############################################################
# ISSUE #46 - READ VEHICLE AFTER IMAGE UPLOAD
############################################################
#
# This verifies the vehicle and image relationship after the
# upload operation.
#
############################################################

### ISSUE #46 - GET VEHICLE WITH IMAGE
GET {{baseUrl}}/api/cars/<CREATED_CAR_ID>


############################################################
# SEARCH ENGINE FEEDS
############################################################

### DYNAMIC XML SITEMAP
GET {{baseUrl}}/sitemap.xml


### DYNAMIC RSS FEED
GET {{baseUrl}}/rss.xml


############################################################
# CHAT TRANSCRIPT STORAGE
#
# EXISTING CHAT TEST FIXTURES
#
# CUSTOMER = 2
# CAR      = 1
#
# conversationId = customer-2-car-1
#
# These are legacy chat verification fixtures and are
# independent from the Issue #46 inventory test vehicle.
#
############################################################


############################################################
# 1. SAVE CUSTOMER MESSAGE 1
############################################################

### SAVE CUSTOMER MESSAGE 1
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "conversationId": "customer-2-car-1",
  "clientMessageId": "customer-msg-001",
  "customerId": 2,
  "carId": 1,
  "sender": "customer",
  "message": "Hello, is the Toyota Land Cruiser still available?"
}


############################################################
# 2. SAVE CUSTOMER MESSAGE 2
############################################################

### SAVE CUSTOMER MESSAGE 2
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "conversationId": "customer-2-car-1",
  "clientMessageId": "customer-msg-002",
  "customerId": 2,
  "carId": 1,
  "sender": "customer",
  "message": "Can I arrange a test drive?"
}


############################################################
# 3. CLIENT MESSAGE ID / DUPLICATE RECONCILIATION
############################################################

### RETRY SAME CUSTOMER MESSAGE
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "conversationId": "customer-2-car-1",
  "clientMessageId": "customer-msg-002",
  "customerId": 2,
  "carId": 1,
  "sender": "customer",
  "message": "Can I arrange a test drive?"
}


############################################################
# 4. CUSTOMER FETCH CHAT HISTORY
############################################################

### CUSTOMER FETCH CHAT HISTORY
GET {{baseUrl}}/api/chat/conversations/customer-2-car-1/messages?page=1&limit=30
Authorization: Bearer {{customerToken}}


############################################################
# 5. ADMIN FETCH CHAT HISTORY
############################################################

### ADMIN FETCH CHAT HISTORY
GET {{baseUrl}}/api/chat/conversations/customer-2-car-1/messages?page=1&limit=30
Authorization: Bearer {{adminToken}}


############################################################
# 6. HISTORY PAGINATION
############################################################

### HISTORY PAGE 1 - LIMIT 1
GET {{baseUrl}}/api/chat/conversations/customer-2-car-1/messages?page=1&limit=1
Authorization: Bearer {{adminToken}}


### HISTORY PAGE 2 - LIMIT 1
GET {{baseUrl}}/api/chat/conversations/customer-2-car-1/messages?page=2&limit=1
Authorization: Bearer {{adminToken}}


############################################################
# 7. ADMIN CONVERSATION LIST BEFORE ADMIN REPLY
############################################################

### GET ADMIN CONVERSATIONS BEFORE REPLY
GET {{baseUrl}}/api/admin/chat/conversations?page=1&limit=20
Authorization: Bearer {{adminToken}}


############################################################
# 8. SAVE ADMIN REPLY
############################################################

### SAVE ADMIN MESSAGE
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "conversationId": "customer-2-car-1",
  "clientMessageId": "admin-msg-001",
  "customerId": 2,
  "carId": 1,
  "sender": "admin",
  "message": "Yes, the Land Cruiser is available and we can arrange a test drive."
}


############################################################
# 9. ADMIN CONVERSATION LIST AFTER ADMIN REPLY
############################################################

### ADMIN CONVERSATION LIST AFTER REPLY
GET {{baseUrl}}/api/admin/chat/conversations?page=1&limit=20
Authorization: Bearer {{adminToken}}


############################################################
# 10. ADMIN CONVERSATION LIST PAGINATION
############################################################

### ADMIN CONVERSATIONS PAGE 1
GET {{baseUrl}}/api/admin/chat/conversations?page=1&limit=10
Authorization: Bearer {{adminToken}}


### ADMIN CONVERSATIONS PAGE 2
GET {{baseUrl}}/api/admin/chat/conversations?page=2&limit=10
Authorization: Bearer {{adminToken}}


############################################################
# 11. PERSISTED UNREAD STATE
############################################################

### CHECK UNREAD STATE
GET {{baseUrl}}/api/admin/chat/conversations?page=1&limit=20
Authorization: Bearer {{adminToken}}


############################################################
# 12. MARK CONVERSATION AS READ
############################################################

### MARK CONVERSATION AS READ
PATCH {{baseUrl}}/api/admin/chat/conversations/customer-2-car-1/read
Authorization: Bearer {{adminToken}}


############################################################
# 13. MARK-AS-READ IDEMPOTENCY
############################################################

### MARK SAME CONVERSATION AS READ AGAIN
PATCH {{baseUrl}}/api/admin/chat/conversations/customer-2-car-1/read
Authorization: Bearer {{adminToken}}


############################################################
# 14. VERIFY PERSISTED UNREAD STATE
############################################################

### CHECK AFTER MARK-AS-READ
GET {{baseUrl}}/api/admin/chat/conversations?page=1&limit=20
Authorization: Bearer {{adminToken}}


############################################################
# 15. TRANSCRIPT RETENTION POLICY
############################################################

### GET RETENTION POLICY
GET {{baseUrl}}/api/admin/chat/retention-policy
Authorization: Bearer {{adminToken}}


############################################################
# AUTHENTICATION TESTS
############################################################

### 16. ADMIN CONVERSATIONS WITHOUT TOKEN
GET {{baseUrl}}/api/admin/chat/conversations


### 17. CHAT HISTORY WITHOUT TOKEN
GET {{baseUrl}}/api/chat/conversations/customer-2-car-1/messages


############################################################
# ADMIN AUTHORIZATION TESTS
############################################################

### 18. CUSTOMER TRIES ADMIN CONVERSATION LIST
GET {{baseUrl}}/api/admin/chat/conversations
Authorization: Bearer {{customerToken}}


### 19. CUSTOMER TRIES MARK-AS-READ
PATCH {{baseUrl}}/api/admin/chat/conversations/customer-2-car-1/read
Authorization: Bearer {{customerToken}}


### 20. CUSTOMER TRIES RETENTION POLICY
GET {{baseUrl}}/api/admin/chat/retention-policy
Authorization: Bearer {{customerToken}}


############################################################
# CUSTOMER OWNERSHIP AUTHORIZATION
############################################################

### 21. CUSTOMER TRIES TO SEND FOR ANOTHER CUSTOMER
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "conversationId": "customer-1-car-1",
  "clientMessageId": "forbidden-msg-001",
  "customerId": 1,
  "carId": 1,
  "sender": "customer",
  "message": "I should not be allowed to send this as customer 1."
}


############################################################
# ERROR RESPONSE CONTRACT
############################################################

### 22. EMPTY MESSAGE
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "conversationId": "customer-2-car-1",
  "clientMessageId": "invalid-msg-001",
  "customerId": 2,
  "carId": 1,
  "sender": "customer",
  "message": ""
}


### 23. MISSING CLIENT MESSAGE ID
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "conversationId": "customer-2-car-1",
  "customerId": 2,
  "carId": 1,
  "sender": "customer",
  "message": "This request has no client message ID."
}


### 24. INVALID VEHICLE
POST {{baseUrl}}/api/chat/messages
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "conversationId": "customer-2-car-99999",
  "clientMessageId": "invalid-car-msg-001",
  "customerId": 2,
  "carId": 99999,
  "sender": "customer",
  "message": "Is this vehicle available?"
}


### 25. UNKNOWN CONVERSATION MARK-AS-READ
PATCH {{baseUrl}}/api/admin/chat/conversations/does-not-exist/read
Authorization: Bearer {{adminToken}}


############################################################
# WINSTON ERROR LOGGING
############################################################

### 26. FORCE INTENTIONAL 500 ERROR
#
# DEVELOPMENT ONLY
#
# Expected:
# HTTP 500
#
# Then inspect:
# Get-Content logs\error.log -Tail 20
#
GET {{baseUrl}}/api/test-error


############################################################
# HEALTH CHECK
############################################################

### 27. BACKEND HEALTH
GET {{baseUrl}}/api/health


############################################################
# FINAL CHAT VERIFICATION
############################################################

### 28. FINAL CONVERSATION HISTORY
GET {{baseUrl}}/api/chat/conversations/customer-2-car-1/messages?page=1&limit=30
Authorization: Bearer {{adminToken}}


### 29. FINAL ADMIN CONVERSATION SUMMARY
GET {{baseUrl}}/api/admin/chat/conversations?page=1&limit=20
Authorization: Bearer {{adminToken}}
