{
  "name": "@figma/my-make-file-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node --check server.js",
    "cleanup:car-images": "node scripts/cleanupStaleCarImages.js --dry-run",
    "cleanup:car-images:execute": "node scripts/cleanupStaleCarImages.js --execute",
    "cleanup:car-images:job": "node -e \"import('./jobs/cleanupStaleCarImagesJob.js').then(async (m) => console.log(JSON.stringify(await m.runCleanupStaleCarImagesJob(), null, 2)))\"",
    "test:car-image-cleanup": "node tests/carImageCleanup.manual.js",
    "test:admin-operations": "node tests/adminOperationsContract.manual.js",
    "test:auth-registration": "node tests/authRegistration.manual.js",
    "test:email-verification": "node tests/authEmailVerification.manual.js",
    "test:phase3-auth": "npm run test:auth-registration && npm run test:email-verification",
    "test:login-security": "node tests/authLoginSecurity.manual.js",
    "test:phase4-auth": "npm run test:login-security",
    "test:password-reset": "node tests/passwordReset.manual.js",
    "test:phase5-auth": "npm run test:password-reset"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pdfmake": "^0.3.11",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.21.0",
    "sharp": "^0.35.3",
    "winston": "^3.19.0",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
