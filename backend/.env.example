# Server
PORT=5500

# Database / Auth
MONGO_URI=replace_with_database_connection_string
DATABASE_URL=replace_with_postgresql_connection_string
JWT_SECRET=replace_with_secure_jwt_secret
LAZY_INDEXING_ENABLED=true

# Email Provider
# Supported values: pending, nodemailer, sendgrid
EMAIL_PROVIDER=pending

# Shared Email Settings
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=support@example.com

# Nodemailer Settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_email_user
EMAIL_PASSWORD=replace_with_email_password
EMAIL_SECURE=false

# SendGrid Settings
SENDGRID_API_KEY=replace_with_sendgrid_api_key

# Image Optimization (upload pipeline)
# Uploaded images are converted to .webp and constrained to max dimensions.
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=1600
IMAGE_WEBP_QUALITY=auto:good
