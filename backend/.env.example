# Server
PORT=5500

# Database / Auth
DATABASE_URL=postgresql://database_user:database_password@localhost:5432/cardealership
DATABASE_SSL=false
JWT_SECRET=replace_with_secure_jwt_secret

# Email Provider
# Supported values: pending, nodemailer, sendgrid
EMAIL_PROVIDER=pending

# Shared Email Settings
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=support@example.com

# Nodemailer Settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_email_user
EMAIL_PASSWORD=replace_with_email_password
EMAIL_SECURE=false

# SendGrid Settings
SENDGRID_API_KEY=replace_with_sendgrid_api_key

# Storage Cleanup
STORAGE_PROVIDER=pending
IMAGE_STORAGE_PROVIDER=pending
CLEANUP_STORAGE_DELETE_ENABLED=false

# Cloudinary Storage
CLOUDINARY_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_KEY=replace_with_cloudinary_api_key
CLOUDINARY_SECRET=replace_with_cloudinary_api_secret

# Scheduled Cleanup Job
CLEANUP_CRON_ENABLED=false
CLEANUP_CRON_SCHEDULE=0 2 * * *
CLEANUP_DRY_RUN=true
CLEANUP_OLDER_THAN_DAYS=30
CLEANUP_LIMIT=100
CLEANUP_STATUSES=Draft,Deleted
