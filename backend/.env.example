# Backend runtime
PORT=5000
MONGO_URI=
JWT_SECRET=

# Sprint 9 exchange-rate integration
EXCHANGE_RATE_PROVIDER=mock
EXCHANGE_RATE_BASE_CURRENCY=UGX
EXCHANGE_RATE_SUPPORTED_CURRENCIES=UGX,USD,EUR,GBP,KES
EXCHANGE_RATE_REFRESH_INTERVAL_MS=3600000
EXCHANGE_RATE_REQUEST_TIMEOUT_MS=5000
EXCHANGE_RATE_CACHE_TTL_MS=7200000
EXCHANGE_RATE_MOCK_SCENARIO=success

# Sprint 9 bulk image uploads
BULK_IMAGE_UPLOAD_FIELD_NAME=images
BULK_IMAGE_UPLOAD_MAX_FILES=10
BULK_IMAGE_UPLOAD_MAX_FILE_SIZE_BYTES=5242880
BULK_IMAGE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
BULK_IMAGE_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
